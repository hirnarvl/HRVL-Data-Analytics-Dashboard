{
  "entities": {
    "outbreak": {
      "title": "Outbreak",
      "description": "Veterinary epizootiological outbreak incident report",
      "type": "object",
      "properties": {
        "region": { "type": "string", "maxLength": 100 },
        "zone": { "type": "string", "maxLength": 100 },
        "woreda": { "type": "string", "maxLength": 100 },
        "disease": { "type": "string", "maxLength": 100 },
        "species": { "type": "string", "maxLength": 100 },
        "cases": { "type": "number" },
        "deaths": { "type": "number" },
        "date": { "type": "string", "maxLength": 50 }
      },
      "required": ["disease", "species", "cases", "date"]
    },
    "surveillance": {
      "title": "Surveillance",
      "description": "Active and passive field disease surveillance record",
      "type": "object",
      "properties": {
        "region": { "type": "string", "maxLength": 100 },
        "zone": { "type": "string", "maxLength": 100 },
        "woreda": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 50 }
      },
      "required": ["region", "status", "date"]
    }
  },
  "firestore": {
    "/outbreaks/{outbreakId}": {
      "schema": { "$ref": "#/entities/outbreak" },
      "description": "Outbreak events registered by veterinary epidemiologists"
    },
    "/surveillance/{surveillanceId}": {
      "schema": { "$ref": "#/entities/surveillance" },
      "description": "Field disease surveillance records"
    },
    "/test/{testId}": {
      "description": "Health check and connection verification"
    }
  }
}
